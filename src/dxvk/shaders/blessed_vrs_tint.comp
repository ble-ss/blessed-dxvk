// blessed: vrs -- BLESSED_VRS_DEBUG=rate, tints a copy of the lit pass's colour by the shading rate each tile used.
//
// 1x1: untouched. 1x2 or 2x1: yellow. 2x2: red. Anything coarser: magenta.
// Coarse tiles also get a dark one-pixel grid line on their top and left
// edges, so the 16x16 tiles read as tiles.
#version 460

#extension GL_EXT_scalar_block_layout : require

// blessed: scratch copy of the lit colour (rgba16f), tinted in place and
// copied back by the caller
layout(set = 1, binding = 0, rgba16f)
uniform image2D s_color;

layout(set = 1, binding = 1, r8ui)
uniform readonly uimage2D s_rate;

layout(push_constant, scalar) uniform BlessedVrsTintPush {
  uint width;
  uint height;
  uint texelWidth;
  uint texelHeight;
} pc;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);

  if (p.x >= int(pc.width) || p.y >= int(pc.height))
    return;

  ivec2 tile = p / ivec2(int(pc.texelWidth), int(pc.texelHeight));
  uint rate = imageLoad(s_rate, tile).x;

  if (rate == 0u)
    return;

  vec3 tint = vec3(1.0, 0.2, 1.0);

  if (rate == 1u || rate == 4u)
    tint = vec3(1.0, 0.9, 0.1);
  else if (rate == 5u)
    tint = vec3(1.0, 0.15, 0.1);

  vec4 c = imageLoad(s_color, p);
  c.rgb = mix(c.rgb, c.rgb * tint * 1.5 + tint * 0.02, 0.6);

  ivec2 inTile = p - tile * ivec2(int(pc.texelWidth), int(pc.texelHeight));

  if (inTile.x == 0 || inTile.y == 0)
    c.rgb *= 0.35;

  imageStore(s_color, p, c);
}
