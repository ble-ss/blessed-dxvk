// blessed: BLESSED_AO=rt pass 1/3 -- short cosine rays per (half-res) pixel + temporal accumulation
#version 460

#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

#include "blessed_ao_common.glsl"

layout(set = 1, binding = 0)
uniform texture2D s_depth;

// blessed: last dispatch's accumulation (x = count*2 + ao, yzw = the
// surface's camera-relative position when written; all zero = sky)
layout(set = 1, binding = 1)
uniform texture2D s_history;

layout(set = 1, binding = 2, rgba32f)
uniform writeonly image2D s_accumOut;

// blessed: xyz = reconstructed normal (zero = sky), w = the debug view's value
layout(set = 1, binding = 3, rgba16f)
uniform writeonly image2D s_geoOut;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// blessed: history is capped at this many frames (alpha never below 1/16),
// so a moved object's old occlusion fades in about a quarter second
const float MAX_HISTORY = 16.0;

float fetchDepth(ivec2 c) {
  BlessedAoConstants k = BlessedAoConstants(pc.constantsAddress);
  c = clamp(c, ivec2(0), ivec2(k.fullWidth, k.fullHeight) - 1);
  return texelFetch(sampler2D(s_depth, s_samplers[pc.samplerIndex]), c, 0).r;
}

// blessed: cosine-weighted direction on the hemisphere around n
vec3 cosineHemisphere(vec3 n, vec2 xi) {
  float r = sqrt(xi.x);
  float phi = 6.28318530718 * xi.y;

  vec3 up = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
  vec3 t = normalize(cross(up, n));
  vec3 b = cross(n, t);

  return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - xi.x)));
}

void main() {
  BlessedAoConstants k = BlessedAoConstants(pc.constantsAddress);

  ivec2 tc = ivec2(gl_GlobalInvocationID.xy);
  if (tc.x >= int(k.traceWidth) || tc.y >= int(k.traceHeight))
    return;

  // blessed: at half res, each trace texel samples one pixel of its 2x2
  // block, a different one every frame, so the history integrates all four
  uint s = k.traceScale;
  ivec2 jitter = ivec2(0);
  if (s == 2u) {
    const ivec2 pattern[4] = ivec2[4](ivec2(0, 0), ivec2(1, 1), ivec2(1, 0), ivec2(0, 1));
    jitter = pattern[k.frameIndex & 3u];
  }

  ivec2 fc = min(tc * int(s) + jitter, ivec2(k.fullWidth, k.fullHeight) - 1);
  vec2 fullSize = vec2(k.fullWidth, k.fullHeight);

  float depth = fetchDepth(fc);
  if (depth == k.farDepthValue) {
    imageStore(s_accumOut, tc, vec4(0.0));
    imageStore(s_geoOut, tc, vec4(0.0, 0.0, 0.0, 1.0));
    return;
  }

  vec3 p = unproject(k.invViewProj, fc, depth, fullSize);
  float dist = length(p);

  // blessed: normal from depth -- on each axis, the neighbour closer in 3d
  // wins, so a silhouette edge takes its normal from its own surface
  vec3 pr = unproject(k.invViewProj, fc + ivec2(1, 0), fetchDepth(fc + ivec2(1, 0)), fullSize);
  vec3 pl = unproject(k.invViewProj, fc - ivec2(1, 0), fetchDepth(fc - ivec2(1, 0)), fullSize);
  vec3 pd = unproject(k.invViewProj, fc + ivec2(0, 1), fetchDepth(fc + ivec2(0, 1)), fullSize);
  vec3 pu = unproject(k.invViewProj, fc - ivec2(0, 1), fetchDepth(fc - ivec2(0, 1)), fullSize);

  vec3 dx = length(pr - p) < length(p - pl) ? pr - p : p - pl;
  vec3 dy = length(pd - p) < length(p - pu) ? pd - p : p - pu;
  vec3 n = cross(dx, dy);
  float nLen = length(n);
  n = nLen > 1.0e-12 ? n / nLen : -p / max(dist, 1.0e-6);
  if (dot(n, p) > 0.0)
    n = -n;

  float footprint = max(min(length(pr - p), length(p - pl)), 1.0e-4);

  // blessed: the rays. origin nudged off the surface along the normal, in
  // the tlas's frame (camDelta, as the shadow pass)
  float visRaw = 1.0;
  if (pc.tlasValid != 0u) {
    vec3 origin = p + k.camDelta + n * (0.002 * dist + 0.5);
    uint rays = max(k.rays, 1u);
    float occ = 0.0;

    for (uint i = 0u; i < rays; i++) {
      vec2 xi = vec2(
        blessedAoHash(uvec2(tc), k.frameIndex * 32u + i * 2u),
        blessedAoHash(uvec2(tc) + uvec2(71u, 13u), k.frameIndex * 32u + i * 2u + 1u));
      vec3 dir = cosineHemisphere(n, xi);

      rayQueryEXT rq;
      rayQueryInitializeEXT(rq, accelerationStructureEXT(pc.tlasAddress),
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFF,
        origin, 0.0, dir, k.radius);
      while (rayQueryProceedEXT(rq)) { }

      if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        // blessed: soft falloff toward the radius, so the edge of the
        // search sphere never draws a line
        float t = rayQueryGetIntersectionTEXT(rq, true) / k.radius;
        occ += 1.0 - t * t;
      }
    }

    visRaw = 1.0 - occ / float(rays);
  }

  // blessed: temporal. history reprojects with the camera of the dispatch
  // that wrote it (the shadow-slide fix): shift into its camera's frame,
  // project with its view-projection, then a hand-rolled bilinear over the
  // four history texels, each kept only if its stored 3d position lies on
  // this pixel's surface
  vec3 posPrev = p + k.reprojDelta;
  float histAo = 0.0, histCount = 0.0, histW = 0.0;
  float reprojCode = 1.0;

  vec4 clipPrev = vec4(posPrev, 1.0) * k.prevViewProj;
  if (k.historyValid != 0u && clipPrev.w > 0.0 && k.debugMode != BLESSED_AO_DEBUG_RAW) {
    vec3 ndcPrev = clipPrev.xyz / clipPrev.w;
    vec2 uvPrev = vec2(ndcPrev.x * 0.5 + 0.5, (1.0 - ndcPrev.y) * 0.5);
    vec2 tPrev = uvPrev * vec2(k.traceWidth, k.traceHeight) - 0.5;
    ivec2 base = ivec2(floor(tPrev));
    vec2 f = tPrev - vec2(base);

    float planeTol = 0.01 * dist + 1.0;
    float distTol  = 4.0 * float(s) * footprint + 0.02 * dist + 1.0;
    float nearestErr = -1.0, nearestBw = -1.0;

    for (uint i = 0u; i < 4u; i++) {
      ivec2 o = ivec2(i & 1u, i >> 1u);
      ivec2 t = base + o;
      if (any(lessThan(t, ivec2(0))) || any(greaterThanEqual(t, ivec2(k.traceWidth, k.traceHeight))))
        continue;

      vec4 h = texelFetch(sampler2D(s_history, s_samplers[pc.samplerIndex]), t, 0);
      if (dot(h.yzw, h.yzw) == 0.0)
        continue;

      vec3 delta = h.yzw - posPrev;
      float err = length(delta);
      float bw = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
      if (bw > nearestBw) {
        nearestBw  = bw;
        nearestErr = err;
      }

      if (abs(dot(n, delta)) > planeTol || err > distTol)
        continue;

      float c = floor(h.x * 0.5);
      histAo    += bw * (h.x - 2.0 * c);
      histCount += bw * c;
      histW     += bw;
    }

    // blessed: BLESSED_AO_DEBUG=reproj -- 16 per full-res pixel of error
    // (saturating at 254/255), 1.0 = nothing to compare
    if (nearestErr >= 0.0)
      reprojCode = min(nearestErr / footprint * 16.0, 254.0) / 255.0;
  }

  float count = 1.0;
  float ao = visRaw;
  if (histW > 0.05) {
    count = min(floor(histCount / histW + 0.5) + 1.0, MAX_HISTORY);
    ao = mix(histAo / histW, visRaw, 1.0 / count);
  }

  imageStore(s_accumOut, tc, vec4(count * 2.0 + clamp(ao, 0.0, 1.0), p));

  float debugValue = visRaw;
  if (k.debugMode == BLESSED_AO_DEBUG_HIST)
    debugValue = (count - 1.0) / (MAX_HISTORY - 1.0);
  else if (k.debugMode == BLESSED_AO_DEBUG_NORMAL)
    debugValue = clamp(dot(n, -p / max(dist, 1.0e-6)), 0.0, 1.0);
  else if (k.debugMode == BLESSED_AO_DEBUG_REPROJ)
    debugValue = reprojCode;

  imageStore(s_geoOut, tc, vec4(n, debugValue));
}
