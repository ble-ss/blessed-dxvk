// blessed: rt selftest -- fires 4 rays at 1 triangle via ray query, no descriptors (push-constant addresses only)
#version 460

#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(buffer_reference, scalar, buffer_reference_align = 4) buffer BlessedRtSelftestOutput {
  uint result[4];
};

layout(push_constant, scalar) uniform BlessedRtSelftestPushData {
  uint64_t                  tlasAddress;
  BlessedRtSelftestOutput   outputBuffer;
} pc;

layout(local_size_x = 4, local_size_y = 1, local_size_z = 1) in;

// Rays start at (x, y, 0) and fire straight along +z. The one triangle in
// the tlas is (0,0,5)-(1,0,5)-(0,1,5): a hit needs x >= 0, y >= 0, x+y <= 1.
// Expected: rays 0 and 3 hit, rays 1 and 2 miss (2 hits, 2 misses).
const vec2 rayOriginsXY[4] = vec2[4](
  vec2( 0.2,  0.2),
  vec2( 0.9,  0.9),
  vec2(-0.5,  0.5),
  vec2( 0.1,  0.8)
);

void main() {
  uint idx = gl_GlobalInvocationID.x;
  if (idx >= 4u)
    return;

  vec3 origin = vec3(rayOriginsXY[idx], 0.0);
  vec3 dir    = vec3(0.0, 0.0, 1.0);

  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, accelerationStructureEXT(pc.tlasAddress),
    gl_RayFlagsOpaqueEXT, 0xFF, origin, 0.001, dir, 10.0);

  while (rayQueryProceedEXT(rq)) { }

  bool hit = rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
  pc.outputBuffer.result[idx] = hit ? 1u : 0u;
}
